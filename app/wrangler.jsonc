{
  // Cloudflare Workers static-assets deployment of the built PWA.
  // Cloudflare Workers Builds: build command `npm ci && npm run build`, deploy command `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workout-app",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
