  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.5.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "5.4.21",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "2.1.9"
  }
